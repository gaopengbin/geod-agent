{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobEvent",
  "type": "object",
  "properties": {
    "completedTiles": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "failureDiagnostic": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureDiagnostic"
        },
        {
          "type": "null"
        }
      ]
    },
    "jobId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "processingStage": {
      "type": [
        "string",
        "null"
      ]
    },
    "seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "totalTiles": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "jobId",
    "seq",
    "occurredAt",
    "state"
  ],
  "$defs": {
    "DiskLocation": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "requiredBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "requiredBytes"
      ]
    },
    "DiskPreflight": {
      "type": "object",
      "properties": {
        "volumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiskVolumeCheck"
          }
        }
      },
      "required": [
        "volumes"
      ]
    },
    "DiskVolumeCheck": {
      "type": "object",
      "properties": {
        "availableBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiskLocation"
          }
        },
        "requiredBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sufficient": {
          "type": "boolean"
        }
      },
      "required": [
        "locations",
        "requiredBytes",
        "availableBytes",
        "sufficient"
      ]
    },
    "FailureDiagnostic": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "storage"
            },
            "report": {
              "$ref": "#/$defs/DiskPreflight"
            }
          },
          "required": [
            "kind",
            "report"
          ]
        },
        {
          "type": "object",
          "properties": {
            "authenticationConfigured": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "httpStatus": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "sourceAccess"
            },
            "sourceId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "httpStatus",
            "host",
            "sourceId",
            "authenticationConfigured"
          ]
        }
      ]
    },
    "JobState": {
      "type": "string",
      "enum": [
        "queued",
        "downloading",
        "paused",
        "processing",
        "verifying",
        "completed",
        "partial",
        "failed",
        "cancelled"
      ]
    }
  }
}
