{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskSpec",
  "type": "object",
  "properties": {
    "boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundaryGeometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "bounds": {
      "description": "WGS84 [west, south, east, north]. Antimeridian bounds must be split.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      },
      "maxItems": 4,
      "minItems": 4
    },
    "kind": {
      "$ref": "#/$defs/TaskKind"
    },
    "limits": {
      "$ref": "#/$defs/ResourceLimits"
    },
    "outputDirectory": {
      "type": "string"
    },
    "outputFormats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputFormat"
      }
    },
    "schemaVersion": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "sourceId": {
      "type": "string"
    },
    "zoomLevels": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sourceId",
    "bounds",
    "zoomLevels",
    "outputFormats",
    "outputDirectory",
    "limits"
  ],
  "$defs": {
    "BoundaryGeometry": {
      "type": "object",
      "properties": {
        "polygons": {
          "description": "Polygon → ring → WGS84 [longitude, latitude]. The first ring is the\nexterior; later rings are holes. MultiPolygon members are independent.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "polygons"
      ]
    },
    "OutputFormat": {
      "type": "string",
      "enum": [
        "geotiff",
        "mbtiles"
      ]
    },
    "ResourceLimits": {
      "type": "object",
      "properties": {
        "maxDecodedRgbaBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "maxTiles": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "maxTiles",
        "maxDecodedRgbaBytes"
      ]
    },
    "SchemaVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "TaskKind": {
      "type": "string",
      "enum": [
        "imagery"
      ]
    }
  }
}
