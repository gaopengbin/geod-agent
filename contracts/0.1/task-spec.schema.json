{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskSpec",
  "type": "object",
  "properties": {
    "boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundaryGeometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "bounds": {
      "description": "WGS84 [west, south, east, north]. Antimeridian bounds must be split.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      },
      "maxItems": 4,
      "minItems": 4
    },
    "exportOptions": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExportOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/$defs/TaskKind"
    },
    "limits": {
      "$ref": "#/$defs/ResourceLimits"
    },
    "outputDirectory": {
      "type": "string"
    },
    "outputFormats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputFormat"
      }
    },
    "schemaVersion": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "sourceId": {
      "type": "string"
    },
    "zoomLevels": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sourceId",
    "bounds",
    "zoomLevels",
    "outputFormats",
    "outputDirectory",
    "limits"
  ],
  "$defs": {
    "BoundaryGeometry": {
      "type": "object",
      "properties": {
        "polygons": {
          "description": "Polygon → ring → WGS84 [longitude, latitude]. The first ring is the\nexterior; later rings are holes. MultiPolygon members are independent.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "polygons"
      ]
    },
    "ElevationEncoding": {
      "type": "string",
      "enum": [
        "terrarium"
      ]
    },
    "ExportOptions": {
      "type": "object",
      "properties": {
        "buildPyramid": {
          "type": "boolean",
          "default": false
        },
        "cacheOnly": {
          "description": "Explicitly export verified cached tiles; never make a tile network request.",
          "type": "boolean"
        },
        "compression": {
          "$ref": "#/$defs/TiffCompression",
          "default": "none"
        },
        "elevationEncoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElevationEncoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "generateSidecars": {
          "type": "boolean",
          "default": false
        },
        "jpegQuality": {
          "type": "integer",
          "format": "uint8",
          "default": 90,
          "maximum": 255,
          "minimum": 0
        },
        "overlaySources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OverlaySourceRef"
          }
        },
        "resampling": {
          "$ref": "#/$defs/RasterResampling"
        },
        "reuseVerifiedCache": {
          "description": "A recovery plan keeps previously verified pixels even after the normal\nfreshness window. Hash, size, decoding and source revision still apply.",
          "type": "boolean"
        },
        "targetCrs": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "OutputFormat": {
      "type": "string",
      "enum": [
        "geotiff",
        "mbtiles",
        "png",
        "jpeg",
        "gpkg",
        "tiles"
      ]
    },
    "OverlaySourceRef": {
      "type": "object",
      "properties": {
        "configRevision": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceId",
        "configRevision"
      ]
    },
    "RasterResampling": {
      "type": "string",
      "enum": [
        "nearest",
        "bilinear",
        "cubic"
      ]
    },
    "ResourceLimits": {
      "type": "object",
      "properties": {
        "maxDecodedRgbaBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "maxTiles": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "maxTiles",
        "maxDecodedRgbaBytes"
      ]
    },
    "SchemaVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "TaskKind": {
      "type": "string",
      "enum": [
        "imagery"
      ]
    },
    "TiffCompression": {
      "type": "string",
      "enum": [
        "none",
        "lzw",
        "deflate"
      ]
    }
  }
}
