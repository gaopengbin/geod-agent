GEOD_AGENT_LISTEN_HOST=127.0.0.1
GEOD_AGENT_LISTEN_PORT=8786
GEOD_AGENT_DB_PATH=
GEOD_IDENTITY_ORIGIN=
GEOD_AGENT_GATEWAY_SECRET=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEOD_AGENT_TOKEN_LIMIT=100000
# enforced uses the hosted Credits wallet; unlimited is for development testing.
GEOD_AGENT_QUOTA_MODE=enforced
# New Agent wallets receive a one-time 20,000 Credits gift. Set 0 to stop
# new grants; existing gifts remain available and continue usage settlement.
# For unlimited testing, set WELCOME_CREDITS=0 (no gifts or wallet charges).
GEOD_AGENT_WELCOME_CREDITS=20000
GEOD_AGENT_WELCOME_POLICY_ID=geod-agent-welcome-v1
# Total recipients across policy versions, devices and restarts; existing grants count.
GEOD_AGENT_WELCOME_MAX_RECIPIENTS=100
# Operator-owned sponsored activities; provider keys use separate apiKeyEnv entries.
# Protocols: chatCompletions (default), responses, anthropic, gemini.
# Optional startsAt/endsAt must include a time zone. Usage remains cumulative per id.
GEOD_AGENT_SPONSORS_JSON=[]
# Optional reviewed server-only payment configuration. Leave blank for no
# cash-payment provider calls. Welcome Credits do not require this setting.
# payment-config.example.json is intentionally disabled and is not runnable.
GEOD_AGENT_PAYMENT_CONFIG=
