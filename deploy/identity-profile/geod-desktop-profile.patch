@@ -0,0 +1,27 @@
+import { AccountError } from "./errors";
+import { assertSameOrigin, hasActiveAccountSession, publicUser, readAccountJson, requireAccount } from "./service";
+import { accountTransaction } from "./store";
+import { createDefaultNickname } from "./nickname-policy";
+
+/** Nicknames are edited only through the website's signed-in browser session. */
+export async function updateAccountNickname(request: Request) {
+  assertSameOrigin(request);
+  if (request.headers.has("authorization")) throw new AccountError(401, "AUTH_REQUIRED", "Use the GeoD website to edit your profile.");
+  const user = await requireAccount(request);
+  const input = await readAccountJson(request);
+  if (Object.keys(input).some(key => key !== "nickname") || (typeof input.nickname !== "string" && input.nickname !== null)) {
+    throw new AccountError(400, "INVALID_NICKNAME", "Use a nickname of up to 40 characters.");
+  }
+  const raw = input.nickname ?? "";
+  const nickname = raw.trim();
+  if (/[\u0000-\u001f\u007f-\u009f]/u.test(raw) || [...nickname].length > 40) {
+    throw new AccountError(400, "INVALID_NICKNAME", "Use a nickname of up to 40 characters without line breaks.");
+  }
+  return accountTransaction(store => {
+    const current = store.users.find(item => item.id === user.id && !item.disabled);
+    if (!current || !hasActiveAccountSession(store, request, user.id)) throw new AccountError(401, "AUTH_REQUIRED", "Sign in again to continue.");
+    if (nickname) current.nickname = nickname;
+    else current.nickname = createDefaultNickname(store.users);
+    return publicUser(current);
+  });
+}
