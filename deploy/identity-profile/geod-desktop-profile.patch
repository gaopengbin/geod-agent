+++ b/lib/accounts/nickname-policy.ts
@@ -0,0 +1,23 @@
+import { randomInt } from "node:crypto";
+import type { StoredUser } from "./store";
+
+/** Generate once and persist; clients never invent their own account nickname. */
+export function createDefaultNickname(users: readonly Pick<StoredUser, "nickname">[]) {
+  const existing = new Set(users.map(user => user.nickname?.toLowerCase()).filter(Boolean));
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const nickname = `geod${randomInt(36 ** 6).toString(36).padStart(6, "0")}`;
+    if (!existing.has(nickname)) return nickname;
+  }
+  throw new Error("Could not allocate an account nickname");
+}
+
+export function assignMissingNicknames(users: StoredUser[]) {
+  let changed = false;
+  for (const user of users) {
+    if (!user.nickname?.trim()) {
+      user.nickname = createDefaultNickname(users);
+      changed = true;
+    }
+  }
+  return changed;
+}
