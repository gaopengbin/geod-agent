diff --git a/lib/accounts/geod-profile.ts b/lib/accounts/geod-profile.ts
new file mode 100644
index 0000000..3b47548
--- /dev/null
+++ b/lib/accounts/geod-profile.ts
@@ -0,0 +1,18 @@
+import { AccountError } from "./errors";
+import { GEOD_AGENT_SCOPE, GEOD_DESKTOP_CLIENT, resolveGeoDAccessToken } from "./geod-oauth";
+import { accountTransaction } from "./store";
+
+/** Read-only account identity for an authorized first-party desktop client. */
+export async function requireGeoDProfile(request: Request) {
+  const header = request.headers.get("authorization") ?? "";
+  const raw = /^Bearer ([A-Za-z0-9_-]{43})$/i.exec(header)?.[1];
+  const active = raw && await resolveGeoDAccessToken(raw);
+  if (request.method !== "GET" || !active || active.clientId !== GEOD_DESKTOP_CLIENT || active.scope !== GEOD_AGENT_SCOPE) {
+    throw new AccountError(401, "AUTH_REQUIRED", "Sign in to GeoD to continue.");
+  }
+  return accountTransaction(store => {
+    const user = store.users.find(item => item.id === active.userId && !item.disabled);
+    if (!user) throw new AccountError(401, "AUTH_REQUIRED", "Sign in to GeoD to continue.");
+    return { accountId: user.id, email: user.email, nickname: user.nickname ?? null, avatar: user.avatar ?? null };
+  }, true);
+}
