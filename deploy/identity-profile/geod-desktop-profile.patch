+it("serves uploaded bytes through the real OAuth grant and cannot choose another account's avatar", async () => {
+  const first = await account(), other = await account("other@example.test");
+  const png = await sharp({ create: { width: 100, height: 80, channels: 4, background: "#087e8b" } }).png().toBuffer();
+  const upload = await avatarPost(new Request(`${origin}/api/account/avatar`, { method: "POST", headers: { origin, cookie: sessionCookie(first.token), "content-type": "image/png" }, body: new Uint8Array(png) }));
+  expect(upload.status).toBe(200);
+  const response = await avatarGet(request(first.tokens.access_token, "avatar"));
+  expect(response.status).toBe(200);
+  expect(await sharp(Buffer.from(await response.arrayBuffer())).metadata()).toMatchObject({ format: "webp", width: 256, height: 256 });
+  const attempted = new Request(`${origin}/api/account/avatar?accountId=${first.user.id}`, { headers: { authorization: `Bearer ${other.tokens.access_token}` } });
+  expect((await avatarGet(attempted)).status).toBe(404);
+  expect((await avatarDelete(request(first.tokens.access_token, "avatar", "DELETE"))).status).toBe(401);
