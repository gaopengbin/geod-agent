+import { createHash } from "node:crypto";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import sharp from "sharp";
+import { beforeEach, afterEach, expect, it, vi } from "vitest";
+import { GET as profileGet } from "../../app/api/account/session/route";
+import { PATCH as nicknamePatch } from "../../app/api/account/route";
+import { GET as avatarGet, POST as avatarPost, PUT as avatarPut, DELETE as avatarDelete } from "../../app/api/account/avatar/route";
+import { createInvite, registerAccount, sessionCookie } from "./service";
+import { exchangeAuthorizationCode, issueAuthorizationCode, revokeGeoDToken } from "./geod-oauth";
+import { accountTransaction } from "./store";
+
+let directory = "";
+const origin = "https://geod.test";
+beforeEach(async () => {
+  directory = await mkdtemp(path.join(tmpdir(), "geod-profile-test-"));
+  vi.stubEnv("GEOSTYLE_ACCOUNT_DIR", directory);
+  vi.stubEnv("GEOSTYLE_SESSION_SECRET", "isolated-profile-test-secret-over-thirty-two-characters");
+  vi.stubEnv("GEOSTYLE_PUBLIC_ORIGIN", origin);
+});
+afterEach(async () => {
+  vi.unstubAllEnvs();
+  if (!path.resolve(directory).startsWith(path.join(tmpdir(), "geod-profile-test-"))) throw Error("Invalid cleanup path");
+  await rm(directory, { recursive: true, force: true });
+});
+async function account(email = "profile@example.test") {
+  const invite = await createInvite(email);
+  const registered = await registerAccount({ email, inviteCode: invite.inviteCode, password: "test-only-profile-password" }, new Request(origin));
+  const verifier = "v".repeat(64), redirectUri = "http://127.0.0.1:52341/oauth/callback";
+  const code = await issueAuthorizationCode(registered.user.id, { clientId: "geod-agent-desktop", redirectUri, challenge: createHash("sha256").update(verifier).digest("base64url"), state: "s".repeat(32) });
+  const tokens = await exchangeAuthorizationCode({ clientId: "geod-agent-desktop", redirectUri, code, verifier });
+  return { ...registered, tokens };
+}
+function request(token: string, endpoint = "session", method = "GET", body?: BodyInit) {
+  return new Request(`${origin}/api/account/${endpoint}`, { method, headers: { authorization: `Bearer ${token}`, origin }, ...(body ? { body } : {}) });
+}
+it("returns only desktop profile fields and preserves the existing cookie account response", async () => {
+  const user = await account();
+  const preset = await avatarPut(new Request(`${origin}/api/account/avatar`, { method: "PUT", headers: { origin, cookie: sessionCookie(user.token), "content-type": "application/json" }, body: JSON.stringify({ presetId: "coast" }) }));
+  expect(preset.status).toBe(200);
+  const result = await profileGet(request(user.tokens.access_token));
+  expect(result.status).toBe(200);
+  expect(result.headers.get("cache-control")).toBe("no-store");
+  expect(user.user.nickname).toMatch(/^geod[a-z0-9]{6}$/);
+  expect(await result.json()).toEqual({ profile: { accountId: user.user.id, email: user.user.email, nickname: user.user.nickname, avatar: { kind: "preset", id: "coast" } } });
+  const cookie = await profileGet(new Request(`${origin}/api/account/session`, { headers: { cookie: sessionCookie(user.token) } }));
+  expect((await cookie.json()).user.id).toBe(user.user.id);
+});
+
+function nicknameRequest(cookie: string, body: unknown, requestOrigin = origin, bearer?: string) {
+  return new Request(`${origin}/api/account`, { method: "PATCH", headers: { origin: requestOrigin, cookie, "content-type": "application/json", ...(bearer ? { authorization: `Bearer ${bearer}` } : {}) }, body: JSON.stringify(body) });
+}
+it("persists website nickname edits and returns the same value to desktop OAuth clients", async () => {
+  const first = await account(), other = await account("nickname-other@example.test");
+  const before = await accountTransaction(store => structuredClone(store), true);
+  const result = await nicknamePatch(nicknameRequest(sessionCookie(first.token), { nickname: "  老高 🌍  " }));
+  expect(result.status).toBe(200);
+  expect((await result.json()).user.nickname).toBe("老高 🌍");
+  expect((await (await profileGet(request(first.tokens.access_token))).json()).profile.nickname).toBe("老高 🌍");
+  expect((await (await profileGet(request(other.tokens.access_token))).json()).profile.nickname).toBe(other.user.nickname);
+  const after = await accountTransaction(store => structuredClone(store), true);
+  const owner = after.users.find(user => user.id === first.user.id)!;
+  expect(owner.nickname).toBe("老高 🌍");
+  owner.nickname = first.user.nickname;
+  expect(after).toEqual(before);
+  expect((await nicknamePatch(nicknameRequest(sessionCookie(first.token), { nickname: " " }))).status).toBe(200);
+  const resetName = (await (await profileGet(request(first.tokens.access_token))).json()).profile.nickname;
+  expect(resetName).toMatch(/^geod[a-z0-9]{6}$/);
+  expect(resetName).not.toBe(first.user.nickname);
+  expect(resetName).not.toBe(other.user.nickname);
+  expect((await (await profileGet(request(first.tokens.access_token))).json()).profile.nickname).toBe(resetName);
+});
+it("assigns old accounts a persistent default once without overwriting custom names or committing read-only mutations", async () => {
+  const first = await account(), custom = await account("custom-nickname@example.test");
+  await accountTransaction(store => {
+    delete store.users.find(user => user.id === first.user.id)!.nickname;
+    store.users.find(user => user.id === custom.user.id)!.nickname = "已设置的昵称";
+  });
+  await accountTransaction(store => { store.users.find(user => user.id === first.user.id)!.email = "read-only@example.test"; }, true);
+  const saved = JSON.parse(await readFile(path.join(directory, "store.json"), "utf8"));
+  const legacy = saved.users.find((user: { id: string }) => user.id === first.user.id);
+  expect(legacy.nickname).toMatch(/^geod[a-z0-9]{6}$/);
+  expect(legacy.email).toBe(first.user.email);
+  const firstRead = await profileGet(request(first.tokens.access_token));
+  expect((await firstRead.json()).profile.nickname).toBe(legacy.nickname);
