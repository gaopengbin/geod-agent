+it("rejects malformed, revoked, expired and disabled grants without cookie fallback", async () => {
+  const first = await account();
+  expect((await profileGet(request("invalid"))).status).toBe(401);
+  const cookieAndBadBearer = new Request(`${origin}/api/account/session`, { headers: { cookie: sessionCookie(first.token), authorization: "Bearer invalid" } });
