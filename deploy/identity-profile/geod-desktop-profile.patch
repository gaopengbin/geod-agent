+  const first = await account();
+  const cookie = sessionCookie(first.token);
+  for (const nickname of ["a".repeat(41), "a\nb", "a\u0000b", 12, {}, undefined]) {
+    expect((await nicknamePatch(nicknameRequest(cookie, { nickname }))).status).toBe(400);
+  }
+  expect((await nicknamePatch(nicknameRequest(cookie, { nickname: "Allowed", id: "another-user" }))).status).toBe(400);
+  expect((await nicknamePatch(nicknameRequest(cookie, { nickname: "Allowed" }, "https://other.test"))).status).toBe(403);
+  expect((await nicknamePatch(nicknameRequest("", { nickname: "Allowed" }, origin, first.tokens.access_token))).status).toBe(401);
+  expect((await nicknamePatch(nicknameRequest(cookie, { nickname: "Allowed" }, origin, first.tokens.access_token))).status).toBe(401);
+  expect((await nicknamePatch(nicknameRequest(cookie, { nickname: "🌍".repeat(40) }))).status).toBe(200);
