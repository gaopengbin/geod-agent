{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoD Agent",
  "version": "0.2.2",
  "identifier": "dev.geod-agent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "GeoD Agent",
      "decorations": false,
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 660
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http: https: geod-raster: geod-data: geod-terrain:; worker-src 'self' blob:",
      "devCsp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http: https: geod-raster: geod-data: geod-terrain: ws://127.0.0.1:1420; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../../../LICENSE": "LICENSE.txt", "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md", "resources/codex/": "codex-runtime/", "resources/pgedge/": "pgedge-runtime/", "resources/gdal/": "gdal-runtime/", "resources/documents/": "document-runtime/", "resources/dbhub/": "dbhub-runtime/", "resources/audio/": "audio-runtime/", "resources/ocr/": "ocr-runtime/", "resources/legacy-office/": "legacy-office-runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
